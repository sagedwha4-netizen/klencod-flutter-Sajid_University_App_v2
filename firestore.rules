rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /announcements/{announcementId} {
      // Published posts are public to every app installation.
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'type', 'createdAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1200
        && request.resource.data.type in ['announcement', 'task']
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'type', 'createdAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1200
        && request.resource.data.type in ['announcement', 'task'];

      allow delete: if isAdmin();
    }
  }
}
